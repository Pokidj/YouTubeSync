# Publish only the application sources and resources.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG.md
!/docs/
!/scripts/
!/tests/
!/outputs/
/outputs/*
!/outputs/youtube-sync/
!/outputs/youtube-sync-modern/
/outputs/youtube-sync/*
/outputs/youtube-sync-modern/*
!/outputs/youtube-sync/src/
!/outputs/youtube-sync/build_hooks/
!/outputs/youtube-sync/assets/
!/outputs/youtube-sync/README.md
!/outputs/youtube-sync/requirements.txt
!/outputs/youtube-sync/build_exe.ps1
!/outputs/youtube-sync-modern/src/
!/outputs/youtube-sync-modern/assets/
!/outputs/youtube-sync-modern/README.md
!/outputs/youtube-sync-modern/requirements.txt
!/outputs/youtube-sync-modern/build_exe.ps1

__pycache__/
*.py[cod]
.venv/
dist/
build/
*.spec
*.json
*.db*
*.sqlite*
*.log
.env*
client_secret*
token*
credentials*
smoke_appdata/
