# Publish only the application sources and resources.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG.md
!/docs/
!/scripts/
!/tests/
!/archive/
!/Abrir-YouTubeSync.cmd
!/build_exe.ps1
!/outputs/
/outputs/*
!/outputs/youtube-sync-modern/
/outputs/youtube-sync-modern/*
!/outputs/youtube-sync-modern/src/
!/outputs/youtube-sync-modern/build_hooks/
!/outputs/youtube-sync-modern/packaging/
!/outputs/youtube-sync-modern/assets/
!/outputs/youtube-sync-modern/README.md
!/outputs/youtube-sync-modern/requirements.txt
!/outputs/youtube-sync-modern/build_exe.ps1
!/outputs/youtube-sync-modern/Abrir-YouTubeSync.cmd

__pycache__/
*.py[cod]
.venv/
dist/
build/
*.spec
!/outputs/youtube-sync-modern/packaging/YouTubeSync.spec
*.json
*.db*
*.sqlite*
*.log
.env*
client_secret*
token*
credentials*
smoke_appdata/

/archive/*
!/archive/README.md
!/archive/youtube-sync-legacy/
/archive/youtube-sync-legacy/*
!/archive/youtube-sync-legacy/src/
!/archive/youtube-sync-legacy/README.md
!/archive/youtube-sync-legacy/tests/
